# Copy to .env and adjust.
#
# With the defaults below the planner has no paid dependency: geocoding runs
# on Photon and routing on Valhalla, both open source and self-hostable.

# --- Geocoding (place name -> coordinates) --------------------------------
# Provider: photon | nominatim | google, or a '+'-separated fallback chain
# such as "photon+nominatim". Photon is the default: it ships a prebuilt
# index, so self-hosting needs no database import.
GEOCODER=photon

# Host of a self-hosted instance. Leave unset to use the public endpoint.
# Public endpoints are fine for development but are not production services:
# Nominatim caps you at 1 req/s and forbids bulk querying, and Komoot offers
# photon.komoot.io without any SLA.
# GEOCODER_DOMAIN=localhost:2322

# Seconds between geocoding requests. 1.0 respects the public endpoints'
# policy; set to 0 when self-hosting.
GEOCODER_MIN_DELAY=1.0

# Sent as User-Agent. Public OSM endpoints require something identifying.
GEOCODER_USER_AGENT=travel-planner

# --- Travel time / distance matrices --------------------------------------
# Provider: valhalla | google. Valhalla is the default: one instance serves
# driving, walking and cycling from a single set of tiles.
MATRIX_PROVIDER=valhalla

# Self-hosted instance (docker compose up -d):
# VALHALLA_URL=http://localhost:8002
#
# Public instance run by FOSSGIS for the OpenStreetMap project. Lets you run
# the app without Docker, but it is a community service with fair-use
# expectations, not a production backend — self-host before relying on it.
VALHALLA_URL=https://valhalla1.openstreetmap.de

# --- Google (optional) ----------------------------------------------------
# Only needed if you set GEOCODER=google or MATRIX_PROVIDER=google. Google is
# the sole option here that offers live traffic and public transport, and the
# sole one that is billed.
# GCP_API_KEY=your-key-here
